# Used by the root docker-compose.yml to configure all three services
# (mongo, backend, frontend) together. Copy this file to `.env` and fill in
# real secrets before running `docker compose up`.
#
# For running each app outside Docker, use backend/.env.example and
# frontend/.env.example instead.

# --- Backend (Express API) ---
JWT_ACCESS_SECRET=change_this_to_a_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_string
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=20
LOG_LEVEL=info

# Set this to a long random value (openssl rand -base64 32) to enable
# POST /auth/bootstrap-admin for creating/promoting an admin account over
# HTTP. Leave unset to disable the endpoint entirely.
ADMIN_BOOTSTRAP_SECRET=

# Required — restaurant/menu/avatar image uploads go straight to Cloudinary, no
# local-disk fallback. Get these from console.cloudinary.com (free tier is fine).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Required — customer checkout pays through Razorpay. Use TEST MODE keys
# (rzp_test_...) from Dashboard > Settings > API Keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Port the backend API is published on (host side)
PORT=5000

# Origin allowed by the backend's CORS policy — must match wherever the
# frontend is actually served from.
CLIENT_URL=http://localhost:8080

# --- Frontend (React + Nginx) ---
# Baked into the frontend build at build time (Vite inlines env vars), so it
# must point at wherever the *browser* can reach the backend — typically the
# backend's published host port, not an internal Docker service name.
VITE_API_URL=http://localhost:5000/api/v1

# Port the frontend is published on (host side)
FRONTEND_PORT=8080
