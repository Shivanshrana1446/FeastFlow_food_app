# Server
NODE_ENV=development
PORT=5000
API_VERSION=v1
CLIENT_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/food_ordering_db

# Cloudinary — required in every environment. Restaurant logos/covers, menu item
# images, and profile avatars all upload here (no local-disk fallback, since Render's
# free tier filesystem is ephemeral and would silently lose them). Get these three
# values from your Cloudinary dashboard (console.cloudinary.com) after creating a
# free account.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay — required in every environment. Use TEST MODE keys (rzp_test_...) from
# Dashboard > Settings > API Keys. KEY_ID is not a secret (the checkout widget ships
# it to the browser); KEY_SECRET signs/verifies payments server-side and must never
# reach the client.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# JWT
JWT_ACCESS_SECRET=change_this_access_secret_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_refresh_secret_in_production
JWT_REFRESH_EXPIRES_IN=7d

# Security
BCRYPT_SALT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=20

# Set this to a long random value (openssl rand -base64 32) to enable
# POST /auth/bootstrap-admin — creates/promotes an admin account over HTTP,
# for deployments with no shell access to run scripts/seedAdmin.js. Leave
# unset to disable the endpoint entirely (it 403s with no secret configured).
ADMIN_BOOTSTRAP_SECRET=

# Logging
LOG_LEVEL=info
